{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Concept 2: Harmonies of Hope",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base (Pure White)",
					"slug": "base"
				},
				{
					"color": "#0052CC",
					"name": "Contrast (Royal Blue)",
					"slug": "contrast"
				},
				{
					"color": "#FFC700",
					"name": "Accent 1 (Sunshine Yellow)",
					"slug": "accent-1"
				},
				{
					"color": "#091E42",
					"name": "Accent 2 (Deep Charcoal Navy)",
					"slug": "accent-2"
				},
				{
					"color": "#0065FF",
					"name": "Accent 3 (Electric Blue)",
					"slug": "accent-3"
				},
				{
					"color": "#5E6C84",
					"name": "Accent 4 (Friendly Slate)",
					"slug": "accent-4"
				},
				{
					"color": "#F4F8FE",
					"name": "Accent 5 (Ice Blue Tint)",
					"slug": "accent-5"
				},
				{
					"color": "#0052CC20",
					"name": "Accent 6 (Soft Border)",
					"slug": "accent-6"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"src": ["file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|accent-2"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"lineHeight": "1.6"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "9999px"
				},
				"spacing": {
					"padding": {
						"bottom": "0.8rem",
						"left": "2rem",
						"right": "2rem",
						"top": "0.8rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontWeight": "700",
					"letterSpacing": "0.3px"
				}
			},
			"core/heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontWeight": "800",
					"lineHeight": "1.2"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|manrope",
					"fontWeight": "800",
					"letterSpacing": "-0.5px"
				}
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "9999px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-1",
						"text": "var:preset|color|accent-2"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|manrope"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent-3"
					}
				}
			}
		},
		"variations": {
			"section-2": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"elements": {
					"button": {
						"color": {
							"background": "var:preset|color|accent-1",
							"text": "var:preset|color|accent-2"
						},
						":hover": {
							"color": {
								"background": "var:preset|color|base",
								"text": "var:preset|color|contrast"
							}
						}
					},
					"heading": {
						"color": {
							"text": "var:preset|color|base"
						}
					}
				}
			},
			"section-4": {
				"color": {
					"background": "var:preset|color|accent-5",
					"text": "var:preset|color|accent-2"
				}
			}
		}
	}
}
